# Google Analytics 4 measurement ID (example: G-ABC123DEF4)
# Leave blank to keep analytics and the consent prompt disabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional AI enhancement for the support chat.
# Without these, the chat remains available in public site-guide mode.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Contact delivery
# Use a server-side webhook supplied by Formspree, Resend, Zapier, Make, or your own API.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# Newsletter delivery
# Use a server-side webhook supplied by Buttondown, ConvertKit, Mailchimp, Beehiiv, or your own API.
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_TOKEN=
